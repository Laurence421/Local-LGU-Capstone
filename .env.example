# Copy to .env and fill in. Never commit .env.
APP_ENV=local
APP_DEBUG=true
# URL path the app is served under ("" when it is the site root, e.g. on lgu.jampzdev.com)
APP_BASE_URL=/local-lgu-research
# Full public URL of the app (used in emailed links, never taken from the request)
APP_URL=http://localhost/local-lgu-research
APP_TIMEZONE=Asia/Manila
SYSTEM_KEY=research

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=lgu2local
# Database of the Records and Correspondence pages (RACS data)
RECORDS_DB_NAME=lgu2

# Remote (Hostinger) DB used only by the Data Synchronization page. Leave blank to disable it.
CLOUD_DB_HOST=
CLOUD_DB_PORT=3306
CLOUD_DB_USER=
CLOUD_DB_PASS=
CLOUD_DB_NAME=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=LGU System

# Shared with the other LGU2 systems. Rotate together with them.
SSO_SECRET=
# Key RACS and the other systems send to our receive_*/update_*/sync endpoints, and that we send to RACS.
LGU2_API_KEY=
# Key for api_research.php (research inbox)
RESEARCH_INBOX_API_KEY=
# Key for send_to_research.php
SEND_TO_RESEARCH_API_KEY=
RACS_RECEIVE_URL=https://racs.jampzdev.com/receivers/receive_from_lgu2.php
