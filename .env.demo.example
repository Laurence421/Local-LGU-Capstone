# Portfolio LIVE demo — copy to .env on the DEMO server only (never on the real system).
# Visitors are logged in automatically and every save/send/delete is refused.
DEMO_MODE=true
APP_ENV=production
APP_DEBUG=false
# "" when the demo is the site root (e.g. a demo subdomain)
APP_BASE_URL=
APP_URL=https://demo.example.com
APP_TIMEZONE=Asia/Manila
SYSTEM_KEY=research

# A database used ONLY by the demo. tools/seed_demo.php empties and refills it.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=
# Same database: the seed script creates the records tables there too
RECORDS_DB_NAME=

# Everything below stays empty in the demo: no remote sync, no email, no SSO, no partner APIs.
CLOUD_DB_HOST=
CLOUD_DB_PORT=3306
CLOUD_DB_USER=
CLOUD_DB_PASS=
CLOUD_DB_NAME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=LGU System
SSO_SECRET=
LGU2_API_KEY=
RESEARCH_INBOX_API_KEY=
SEND_TO_RESEARCH_API_KEY=
RACS_RECEIVE_URL=
